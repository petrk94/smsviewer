# Node.js dependencies
node_modules/

# npm cache and debug logs
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Environment files and secrets
.env
.env.*
!.env.example

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# Test and browser automation output
playwright-report/
test-results/
coverage/
.nyc_output/
tests/fake-indexeddb.iife.js

# Python cache generated by browser tests
__pycache__/
*.py[cod]

# Temporary and cache directories
.cache/
tmp/
temp/

# Real SMS Backup & Restore files
# Never commit private message backups.
*.xml

# Allow the deliberately fictional public demo backups.
!examples/
!examples/demo-backup.xml
!examples/demo-media-messages.xml

# Message exports generated by the application
sms-backup*.csv
sms-backup*.json
conversation*.csv
conversation*.json
conversation*.pdf
Messages_*.pdf

# Local release archives and checksums
smsviewer-*.zip
sms-viewer-*.zip
*.zip.sha256

# Local authentication or credential files
.credentials
credentials.json
*.token
